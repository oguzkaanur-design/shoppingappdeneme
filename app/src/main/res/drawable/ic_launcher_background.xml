<?xml version="1.0" encoding="utf-8"?>
<!-- Baskit adaptive ikon arka katmanı: derin zümrüt degrade + yumuşak ışık. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="0"
                android:endX="100"
                android:endY="108">
                <item android:offset="0" android:color="#127A5E" />
                <item android:offset="0.55" android:color="#075E48" />
                <item android:offset="1" android:color="#032D23" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sağ üstte hafif ışık: düz degradeyi kırar, ikonu canlandırır. -->
    <path
        android:pathData="M108,0 A54,54 0 0 1 54,54 A54,54 0 0 1 0,0 Z"
        android:fillColor="#34D399"
        android:fillAlpha="0.16" />
</vector>
