    <string name="legal_title">Privacy and terms</string>
    <string name="legal_entry_subtitle">Privacy policy, terms of use and contact</string>
    <string name="legal_privacy_title">Privacy policy</string>
    <string name="legal_privacy_body">Korb works without an account; it shows no ads and collects no usage data. Your shopping list, pantry, spending history and offers are stored on this device.\n\nIf you sign in with Google, your data is backed up to a hidden folder that belongs to the app inside your own Google Drive. No other files are accessed and there is no server of ours. A local account created with email stays on this device; the password itself is never stored.\n\nScanning a barcode sends it to world.openfoodfacts.org, and opening flyers requests marktguru.de. No account details are sent. Backup files are not encrypted.\n\nThe camera is used only for barcodes and receipts; notifications only for reminders.</string>
    <string name="legal_terms_title">Terms of use</string>
    <string name="legal_terms_body">The app is provided as is. Prices and flyers come from third-party sources and may be delayed or wrong; the price on the store shelf is binding.\n\nChanging devices or uninstalling the app without a backup causes data loss. Use the app at your own risk.</string>
    <string name="legal_contact_title">Contact</string>
    <string name="legal_contact_body">For questions and bug reports, use the Issues section of the app repository on GitHub.</string>
    <string name="legal_updated">Last updated: October 2026</string>
